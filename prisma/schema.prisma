generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Department {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  hodAssignments DepartmentHod[]
}

model Role {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  dashboardRoute String   @default("/staff-dashboard")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  id                         Int                @id @default(autoincrement())
  email                      String             @unique
  password                   String
  role                       String
  name                       String?
  department                 String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  announcementsRead          AnnouncementRead[]
  actionsPerformed           Notification[]     @relation("PerformedActions")
  notificationsReceived      Notification[]     @relation("ReceivedNotifications")
  tasksCreated               Task[]             @relation("CreatedBy")
  assignmentsMade            TaskAssignment[]   @relation("AssignedBy")
  tasksAssigned              TaskAssignment[]   @relation("AssignedTo")
  managedDepartmentRelations DepartmentHod[]    @relation("HodAssignments")
  sectionSeen                UserSectionSeen[]
}

model DepartmentHod {
  id           Int        @id @default(autoincrement())
  departmentId Int
  hodId        Int
  assignedAt   DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  hod          User       @relation("HodAssignments", fields: [hodId], references: [id], onDelete: Cascade)

  @@unique([departmentId, hodId])
  @@index([hodId])
  @@index([departmentId])
}

model Task {
  id               Int              @id @default(autoincrement())
  title            String
  description      String?          @db.Text
  department       String?
  priority         String           @default("MEDIUM")
  status           String           @default("PENDING")
  type             String           @default("TASK")
  createdById      Int
  startDate        DateTime?
  dueDate          DateTime?
  estimatedHours   Int?
  visibility       String           @default("ASSIGNED_ONLY")
  escalated        Boolean          @default(false)
  escalatedAt      DateTime?
  escalationReason String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        User             @relation("CreatedBy", fields: [createdById], references: [id])
  assignments      TaskAssignment[]

  @@index([createdById])
  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@index([escalated])
}

model Tender {
  id          Int        @id @default(autoincrement())
  title       String
  referenceNo String     @unique
  description String?    @db.Text
  issuedDate  DateTime   @default(now())
  closingDate DateTime
  department  String
  category    String?
  status      String     @default("OPEN")
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]

  @@index([status])
  @@index([department])
  @@index([createdAt])
}

model Document {
  id         Int      @id @default(autoincrement())
  title      String
  type       String
  department String
  uploadedBy String
  scope      String
  fileSize   String?
  fileUrl    String?  @db.Text
  downloads  Int      @default(0)
  tenderId   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tender     Tender?  @relation(fields: [tenderId], references: [id])

  @@index([type])
  @@index([department])
  @@index([scope])
  @@index([createdAt])
  @@index([tenderId])
}

model TaskAssignment {
  id           Int      @id @default(autoincrement())
  taskId       Int
  userId       Int
  assignedById Int
  status       String   @default("PENDING")
  assignedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedBy   User     @relation("AssignedBy", fields: [assignedById], references: [id])
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User     @relation("AssignedTo", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@index([assignedById], map: "TaskAssignment_assignedById_fkey")
}

model Announcement {
  id            Int                @id @default(autoincrement())
  title         String
  description   String             @db.Text
  date          DateTime           @default(now())
  department    String?
  targetRole    String?
  priority      String             @default("NORMAL")
  scopeType     String             @default("ALL_COMPANY")
  expiresAt     DateTime?
  createdBy     String
  createdByRole String?            @default("STAFF")
  createdById   Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  reads         AnnouncementRead[]

  @@index([date])
  @@index([department])
  @@index([createdAt])
  @@index([createdById])
}

model AnnouncementRead {
  id             Int          @id @default(autoincrement())
  announcementId Int
  userId         Int
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([announcementId])
}

model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int
  actorId     Int
  actorRole   String
  actionType  String
  targetId    Int?
  message     String   @db.Text
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
  actor       User     @relation("PerformedActions", fields: [actorId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([createdAt])
  @@index([read])
  @@index([actorId], map: "Notification_actorId_fkey")
}

model UserSectionSeen {
  id      Int      @id @default(autoincrement())
  userId  Int
  section String
  seenAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
  @@index([userId])
  @@index([section])
}
