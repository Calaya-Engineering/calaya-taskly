generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Department {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  hodAssignments DepartmentHod[]
}

model Role {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  dashboardRoute String   @default("/staff-dashboard")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  id                         Int                @id @default(autoincrement())
  email                      String             @unique
  password                   String
  role                       String
  name                       String?
  department                 String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  announcementsRead          AnnouncementRead[]
  actionsPerformed           Notification[]     @relation("PerformedActions")
  notificationsReceived      Notification[]     @relation("ReceivedNotifications")
  tasksCreated               Task[]             @relation("CreatedBy")
  assignmentsMade            TaskAssignment[]   @relation("AssignedBy")
  tasksAssigned              TaskAssignment[]   @relation("AssignedTo")
  managedDepartmentRelations DepartmentHod[]    @relation("HodAssignments")
  dailyReportsSubmitted      DailyReport[]      @relation("SubmittedDailyReports")
  sectionSeen                UserSectionSeen[]
  eventAcknowledgements      EventAcknowledgement[]
  eventResponses             EventResponse[]
  tenderComments             TenderComment[]
  tenderAcknowledgements     TenderAcknowledgement[]
  auditLogs                  AuditLog[]
  mentionsReceived           Mention[]          @relation("MentionRecipient")
  mentionsMade               Mention[]          @relation("MentionActor")
}

model AccessRequest {
  id              Int       @id @default(autoincrement())
  fullName        String
  email           String
  phone           String
  department      String
  requestedRole   String
  jobTitle        String?
  hodId           Int?
  hodName         String?
  hodEmail        String?
  reason          String    @db.Text
  status          String    @default("PENDING")
  reviewNote      String?   @db.Text
  reviewedAt      DateTime?
  reviewedByEmail String?
  createdUserId   Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([department])
}

model DepartmentHod {
  id           Int        @id @default(autoincrement())
  departmentId Int
  hodId        Int
  assignedAt   DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  hod          User       @relation("HodAssignments", fields: [hodId], references: [id], onDelete: Cascade)

  @@unique([departmentId, hodId])
  @@index([hodId])
  @@index([departmentId])
}

model Task {
  id               Int              @id @default(autoincrement())
  title            String
  description      String?          @db.Text
  department       String?
  priority         String           @default("MEDIUM")
  status           String           @default("PENDING")
  type             String           @default("TASK")
  createdById      Int
  startDate        DateTime?
  dueDate          DateTime?
  estimatedHours   Int?
  visibility       String           @default("ASSIGNED_ONLY")
  assignmentType   String?
  escalated        Boolean          @default(false)
  escalatedAt      DateTime?
  escalationReason String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        User             @relation("CreatedBy", fields: [createdById], references: [id])
  assignments      TaskAssignment[]
  acknowledgements EventAcknowledgement[]
  eventResponses   EventResponse[]

  @@index([createdById])
  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@index([escalated])
}

model Tender {
  id          Int        @id @default(autoincrement())
  title       String
  referenceNo String     @unique
  description String?    @db.Text
  issuedDate  DateTime   @default(now())
  closingDate DateTime
  department  String
  category    String?
  status      String     @default("OPEN")
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]
  comments    TenderComment[]
  acknowledgements TenderAcknowledgement[]

  @@index([status])
  @@index([department])
  @@index([createdAt])
}

model Document {
  id          Int      @id @default(autoincrement())
  title       String
  type        String
  department  String
  uploadedBy  String
  scope       String
  isPrivate   Boolean  @default(false)
  description String?  @db.Text
  fileSize    String?
  fileUrl     String?  @db.Text
  downloads   Int      @default(0)
  tenderId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tender      Tender?  @relation(fields: [tenderId], references: [id])

  @@index([type])
  @@index([department])
  @@index([scope])
  @@index([isPrivate])
  @@index([createdAt])
  @@index([tenderId])
}

model EventAcknowledgement {
  id             Int      @id @default(autoincrement())
  taskId         Int
  userId         Int
  acknowledgedAt DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model EventResponse {
  id          Int      @id @default(autoincrement())
  taskId      Int
  userId      Int
  response    String
  respondedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@index([response])
}

model TenderAcknowledgement {
  id             Int      @id @default(autoincrement())
  tenderId       Int
  userId         Int
  acknowledgedAt DateTime @default(now())
  tender         Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenderId, userId])
  @@index([tenderId])
  @@index([userId])
}

model TenderComment {
  id        Int      @id @default(autoincrement())
  tenderId  Int
  userId    Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userEmail  String?
  userRole   String?
  action     String
  targetType String?
  targetId   Int?
  summary    String?  @db.Text
  metadata   String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Mention {
  id                Int      @id @default(autoincrement())
  mentionedUserId   Int
  actorUserId       Int?
  sourceType        String
  sourceId          Int
  context           String?  @db.Text
  createdAt         DateTime @default(now())
  mentionedUser     User     @relation("MentionRecipient", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  actorUser         User?    @relation("MentionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([mentionedUserId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

model DailyReport {
  id               Int                @id @default(autoincrement())
  title            String
  department       String
  submittedBy      String
  submittedByRole  String?
  submittedByUserId Int?
  reportDate       DateTime
  submittedAt      DateTime           @default(now())
  status           String             @default("PENDING")
  summary          String?
  payloadSource    String?            @db.Text
  attachmentUrl    String?            @db.Text
  attachmentName   String?
  downloads        Int                @default(0)
  legacyDocumentId Int?               @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  entries          DailyReportEntry[]
  submittedByUser  User?              @relation("SubmittedDailyReports", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@index([department])
  @@index([status])
  @@index([reportDate])
  @@index([submittedAt])
  @@index([submittedByUserId])
}

model DailyReportEntry {
  id            Int         @id @default(autoincrement())
  dailyReportId Int
  orderIndex    Int         @default(0)
  taskName      String
  objective     String?     @db.Text
  target        String?     @db.Text
  nextDayTask   String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  @@index([dailyReportId])
  @@index([dailyReportId, orderIndex])
}

model TaskAssignment {
  id           Int      @id @default(autoincrement())
  taskId       Int
  userId       Int
  assignedById Int
  status       String   @default("PENDING")
  assignedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedBy   User     @relation("AssignedBy", fields: [assignedById], references: [id])
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User     @relation("AssignedTo", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@index([assignedById], map: "TaskAssignment_assignedById_fkey")
}

model Announcement {
  id            Int                @id @default(autoincrement())
  title         String
  description   String             @db.Text
  date          DateTime           @default(now())
  department    String?
  targetRole    String?
  priority      String             @default("NORMAL")
  scopeType     String             @default("ALL_COMPANY")
  expiresAt     DateTime?
  createdBy     String
  createdByRole String?            @default("STAFF")
  createdById   Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  reads         AnnouncementRead[]

  @@index([date])
  @@index([department])
  @@index([createdAt])
  @@index([createdById])
}

model AnnouncementRead {
  id             Int          @id @default(autoincrement())
  announcementId Int
  userId         Int
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([announcementId])
}

model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int
  actorId     Int
  actorRole   String
  actionType  String
  targetId    Int?
  message     String   @db.Text
  linkPath    String?  @db.Text
  emailSubject String? @db.Text
  emailStatus String   @default("SKIPPED")
  emailAttempts Int    @default(0)
  emailLastError String? @db.Text
  emailSentAt  DateTime?
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
  actor       User     @relation("PerformedActions", fields: [actorId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([createdAt])
  @@index([read])
  @@index([recipientId, read, createdAt])
  @@index([actionType, targetId, recipientId])
  @@index([emailStatus, emailAttempts, createdAt])
  @@index([actorId], map: "Notification_actorId_fkey")
}

model UserSectionSeen {
  id      Int      @id @default(autoincrement())
  userId  Int
  section String
  seenAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
  @@index([userId])
  @@index([section])
}

model OtpToken {
  id                      Int       @id @default(autoincrement())
  email                   String
  otp                     String
  expiresAt               DateTime
  verifiedAt              DateTime?
  invalidAttempts         Int       @default(0)
  retryAllowanceRemaining Int       @default(1)
  userRole                String
  userRoute               String
  createdAt               DateTime  @default(now())

  @@index([email])
}
